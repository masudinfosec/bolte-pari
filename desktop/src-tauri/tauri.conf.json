{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bolte Pari",
  "version": "1.0.0",
  "identifier": "com.masud.boltepari.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bolte Pari - English A1 to C2",
        "width": 1024,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/[email protected]",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Offline English A1-C2 learning",
    "longDescription": "Bolte Pari - learn English from A1 to C2 completely offline: 2100+ practice questions, interview drill, text-to-speech, progress tracking."
  }
}
